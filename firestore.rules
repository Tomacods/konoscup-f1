rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // El campeonato: cualquiera puede leerlo (para que tus amigos vean la tabla
    // sin loguearse), pero sólo una cuenta autenticada puede escribirlo.
    match /konoscup/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Todo lo demás, cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
